___TESTS___

scenarios:
- name: Sets the workspace and loads both scripts in order
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });
    let pidSet;
    mock('setInWindow', (key, value, overrideExisting) => {
      pidSet = {key: key, value: value, overrideExisting: overrideExisting};
      return true;
    });
    mock('copyFromWindow', (key) => key === 'dataLayer' ? [{event: 'gtm.js'}] : undefined);

    runCode({workspaceId: '12345'});

    assertThat(pidSet).isEqualTo({key: '__pid', value: 12345, overrideExisting: true});
    assertThat(injected).isEqualTo([
      'https://live.activeiq.co/ac.js',
      'https://live.activeiq.co/pid/12345.js'
    ]);
    assertApi('callInWindow').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Starts tracking itself when the page has already finished loading
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      onSuccess();
    });
    mock('copyFromWindow', (key) => key === 'dataLayer' ? [{event: 'gtm.js'}, {event: 'gtm.dom'}, {event: 'gtm.load'}] : undefined);
    mock('callInWindow', (path) => undefined);

    runCode({workspaceId: '12345'});

    assertApi('callInWindow').wasCalledWith('__am_track');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Loads nothing when the Workspace ID is not a number
  code: |-
    runCode({workspaceId: 'abc'});

    assertApi('setInWindow').wasNotCalled();
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Fails when the tracking script does not load
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure) => {
      injected.push(url);
      onFailure();
    });

    runCode({workspaceId: '12345'});

    assertThat(injected).isEqualTo(['https://live.activeiq.co/ac.js']);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Succeeds when only the workspace script does not load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      if (url === 'https://live.activeiq.co/ac.js') {
        onSuccess();
      } else {
        onFailure();
      }
    });
    mock('copyFromWindow', (key) => key === 'dataLayer' ? [{event: 'gtm.js'}, {event: 'gtm.dom'}, {event: 'gtm.load'}] : undefined);
    mock('callInWindow', (path) => undefined);

    runCode({workspaceId: '12345'});

    assertApi('callInWindow').wasCalledWith('__am_track');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
