___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Does what the ActiveIQ Code snippet does:
//   <script>__pid=WORKSPACE_ID;</script>
//   <script src="https://live.activeiq.co/ac.js"></script>
//   <script src="https://live.activeiq.co/pid/WORKSPACE_ID.js"></script>
// ac.js records the visit itself on the page's load event. When the tag
// fires after that (fast pages, a Window Loaded trigger, a consent banner
// that releases the tag late), the event never comes, so the tag starts
// tracking itself (see startTracking).

const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');
const makeInteger = require('makeInteger');
const logToConsole = require('logToConsole');

const BASE_URL = 'https://live.activeiq.co/';

const workspaceId = makeInteger(data.workspaceId);
if (!workspaceId || workspaceId < 1) {
  logToConsole('ActiveIQ: the Workspace ID is missing or not a number:', data.workspaceId);
  data.gtmOnFailure();
  return;
}

// ac.js reads the workspace from window.__pid, as a number.
// setInWindow needs read and write permission on __pid (it checks for an existing value).
setInWindow('__pid', workspaceId, true);

const workspaceScriptUrl = BASE_URL + 'pid/' + workspaceId + '.js';

// Templates can't read the page's document, so use GTM's own record of it:
// GTM pushes a 'gtm.load' event into the dataLayer once the page has loaded.
const pageHasLoaded = () => {
  const dataLayer = copyFromWindow('dataLayer');
  if (!dataLayer || !dataLayer.length) {
    return false;
  }
  for (let i = 0; i < dataLayer.length; i++) {
    if (dataLayer[i] && dataLayer[i].event === 'gtm.load') {
      return true;
    }
  }
  return false;
};

// Runs once both scripts are in. If the page has already finished loading,
// ac.js missed its load event, so start tracking now. __am_track records a
// page only once, so a page whose load event did reach ac.js is not counted twice.
const startTracking = () => {
  const loaded = pageHasLoaded();
  logToConsole('ActiveIQ: scripts loaded, page already loaded:', loaded);
  if (loaded) {
    callInWindow('__am_track');
  }
  data.gtmOnSuccess();
};

// The workspace script can customize ac.js, so it loads after ac.js.
// If it fails, ac.js still tracks, so the tag still counts as a success.
const onAcLoaded = () => {
  injectScript(workspaceScriptUrl, startTracking, () => {
    logToConsole('ActiveIQ: could not load ' + workspaceScriptUrl);
    startTracking();
  }, 'activeiq-pid');
};

const onAcFailed = () => {
  logToConsole('ActiveIQ: could not load ' + BASE_URL + 'ac.js');
  data.gtmOnFailure();
};

// The cache tokens keep each script to one copy per page, even if the tag fires more than once.
injectScript(BASE_URL + 'ac.js', onAcLoaded, onAcFailed, 'activeiq-ac');


